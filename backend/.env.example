# ============================================================
# Business Transformation AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets to version control.
# ============================================================

# Application
PROJECT_NAME="Business Transformation AI"
API_V1_STR="/api/v1"
ENVIRONMENT=development
# Set to "production" in production deployments
DEBUG=True

# Security — CHANGE THIS in production! Use: openssl rand -hex 32
SECRET_KEY=super_secret_jwt_key_change_in_production_123456789

# Database
# Development (SQLite — default, no setup required):
DATABASE_URL=sqlite:///./business_transformation.db

# Production (PostgreSQL — replace with your actual credentials):
# DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>

# CORS — comma-separated list of allowed frontend origins.
# Development default allows localhost Vite dev server.
# Production: set to your actual frontend domain(s).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
# Production example:
# CORS_ORIGINS=https://app.yourdomain.com

# AI / LLM Configuration
# Supported providers: openai, gemini, groq, ollama, custom
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=90

# Ollama (used when LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AI_REQUESTS=20
RATE_LIMIT_AI_WINDOW_SECONDS=3600
RATE_LIMIT_PUBLIC_REQUESTS=30
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60
MAX_CHAT_MESSAGE_LENGTH=4000

# Document Upload
MAX_FILE_SIZE_BYTES=10485760
